# ── Hugging Face ──────────────────────────────────────────────────────────────
# Required. Your HF access token (read permission is enough).
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The LoRA adapter repository (small, ~120MB).
# Base model is read automatically from adapter_config.json.
ADAPTER_MODEL_ID="yashvasudeva/qwen-adapter"

# ── Web App (Node.js / Vercel) ────────────────────────────────────────────────
# If LOCAL_LLM_URL is set, the Node server routes inference requests there
# instead of Hugging Face's hosted inference API.
# Point this to your running inference.py server.
LOCAL_LLM_URL=""
LOCAL_LLM_MODEL="vegapunk-ds"

# ── Gemini fallback ───────────────────────────────────────────────────────────
# Optional. If set, used as fallback when the primary model is unavailable.
GEMINI_API_KEY=""
